# Copy to .env and fill in. Never commit .env.
# Long random strings: e.g. `openssl rand -hex 24`

# Evolution API (WhatsApp gateway)
EVOLUTION_API_KEY=change-me-long-random-string
EVOLUTION_DB_PASSWORD=change-me-another-random-string

# n8n encrypts saved credentials with this. Keep it safe; losing it means re-entering credentials.
N8N_ENCRYPTION_KEY=change-me-third-random-string

# Address n8n is reached at from outside (only needed for the n8n editor link or a public webhook).
N8N_PUBLIC_URL=http://localhost:5678/

# Groq, Gemini and Supabase keys are NOT set here: you add them inside n8n as credentials (README step 5).
