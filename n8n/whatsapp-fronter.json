        "operation": "executeQuery",
        "query": "select * from fronter_inbound($1, $2, $3, $4);",
        "options": {
          "queryReplacement": "={{ [ $json.instance, $json.jid, $json.name, $json.phone ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fronterPostgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "id": "e89b82ed-f7e2-5eff-916e-19b64529f660",
      "name": "Voice Note?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $('Parse Message').first().json.isAudio }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "db3e7bb3-c9b7-5e3c-9815-0295c1107bf4",
      "name": "Audio File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        140
      ],
      "parameters": {
        "jsCode": "// Voice note (base64 from Evolution) -> file for Groq Whisper.\nconst p = $('Parse Message').first().json;\nreturn [{\n  json: {},\n  binary: { file: { data: p.audioBase64, mimeType: 'audio/ogg', fileName: 'voice.ogg' } },\n}];"
      }
    },
    {
      "id": "7f1bb3a3-cb7c-55b0-945b-85d429a407eb",
      "name": "Groq Whisper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "name": "model",
              "value": "whisper-large-v3"
            },
            {
              "name": "language",
              "value": "={{ $('Persona').first().json.stt_language || 'ur' }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "fronterGroq",
          "name": "Groq API key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "e656a5ca-a1c9-54a5-90c0-33c1c28807a7",
      "name": "User Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "// The customer's words: typed text, transcribed voice note, or a note about other media.\nconst p = $('Parse Message').first().json;\nlet user_text = (p.text || '').trim();\nlet media = p.type === 'imageMessage' ? 'image' : 'text';\n\nif (p.isAudio) {\n  media = 'audio';\n  user_text = String($input.first().json.text || '').trim()\n    || '[The customer sent a voice note that could not be understood. Politely ask them to type or send it again.]';\n} else if (!user_text) {\n  media = p.type === 'imageMessage' ? 'image' : 'other';\n  user_text = `[The customer sent a ${p.type.replace('Message', '')} without text. You cannot see it; ask what they need.]`;\n}\nreturn [{ json: { user_text, media } }];"
      }
    },
    {
      "id": "5eef91c7-372f-50ea-bd31-e755c55f3349",
