{
  "name": "AI Fronter - WhatsApp",
  "nodes": [
    {
      "id": "dadb7a21-ccd6-5804-9839-a7845b04b237",
      "name": "WhatsApp Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "5b0c7b1e-7d0e-4c55-9a43-f0d1e2a3b4c5"
    },
    {
      "id": "1cdfae67-1356-531b-b164-be64e6c288a8",
      "name": "Parse Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Turns the Evolution API webhook into simple fields.\nconst body = $input.first().json.body || {};\nconst data = body.data || {};\nconst key = data.key || {};\nconst msg = data.message || {};\n\nlet jid = key.remoteJid || '';\n// Some WhatsApp accounts now show a privacy id (@lid). Use the phone-number id when Evolution gives it.\nif (jid.endsWith('@lid')) jid = key.remoteJidAlt || key.senderPn || jid;\n\nconst type = data.messageType\n  || Object.keys(msg).find(k => !['messageContextInfo', 'base64'].includes(k))\n  || 'unknown';\nconst text = msg.conversation\n  || msg.extendedTextMessage?.text\n  || msg.imageMessage?.caption\n  || msg.videoMessage?.caption\n  || msg.documentMessage?.caption\n  || '';\n\n// Only 1-to-1 chats from customers: no own messages, groups, status updates, channels or broadcasts.\nconst isDirect = Boolean(body.instance) && !key.fromMe\n  && (jid.endsWith('@s.whatsapp.net') || jid.endsWith('@lid'));\n\nreturn [{\n  json: {\n    instance: body.instance || '',\n    jid,\n    phone: jid.endsWith('@s.whatsapp.net') ? jid.split('@')[0] : '',\n    name: data.pushName || '',\n    type,\n    text,\n    isAudio: type === 'audioMessage' || type === 'pttMessage',\n    audioBase64: msg.base64 || '',\n    isDirect,\n  },\n}];"
      }
    },
    {
      "id": "1290002a-33fb-53b0-ad81-638a8ae76f92",
      "name": "Customer Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.isDirect }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "af2f49ee-6957-59f2-88e1-74b0d7d17faa",
      "name": "Persona",
      "type": "n8n-nodes-base.postgres",
